{
  "name": "zi-li-you-niao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:bank": "node tools/runPuzzleBankGenerator.mjs",
    "evaluate:difficulty": "node tools/runDifficultyEvaluation.mjs",
    "analyze:catalog": "vitest run --config tools/vitest.catalog.config.ts tools/catalog-analysis.experiment.ts --reporter=verbose",
    "experiment:catalog": "vitest run --config tools/vitest.catalog.config.ts tools/catalog-sampling.experiment.ts --reporter=verbose",
    "evaluate:level3": "vitest run --config tools/vitest.experiment.config.ts --reporter=verbose",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
